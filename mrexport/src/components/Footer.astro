---
import { categories } from '../data/categories';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-section">
      <img src="/logo.svg" alt="Mr Exporter — Iran Export Hub" width="160" height="40" class="footer-logo" />
      <p class="footer-desc">Your trusted Iran export partner connecting international buyers with quality Iranian products across petrochemicals, metals, industrial goods, food and handicrafts.</p>
    </div>
    <div class="footer-section">
      <h3 class="footer-heading">Categories</h3>
      <ul class="footer-links">
        {categories.map((cat) => (
          <li><a href={`/categories/${cat.slug}`}>{cat.name}</a></li>
        ))}
      </ul>
    </div>
    <div class="footer-section">
      <h3 class="footer-heading">Quick Links</h3>
      <ul class="footer-links">
        <li><a href="/products">All Products</a></li>
        <li><a href="/">Home</a></li>
        <li><a href="https://wa.me/989143403431" target="_blank" rel="noopener noreferrer">WhatsApp Inquiry</a></li>
      </ul>
    </div>
    <div class="footer-section">
      <h3 class="footer-heading">Contact</h3>
      <p class="footer-contact">WhatsApp: +98 914 340 3431</p>
      <a href="https://wa.me/989143403431" class="footer-cta" target="_blank" rel="noopener noreferrer">Send Inquiry</a>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Mr Exporter. All rights reserved. Iran Export Hub.</p>
  </div>
</footer>

<style>
.site-footer {
  background: #0f172a;
  color: #cbd5e1;
  margin-top: 4rem;
  padding: 3rem 1.5rem 1.5rem;
}
.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr;
  gap: 2rem;
}
.footer-logo {
  margin-bottom: 0.75rem;
  display: block;
}
.footer-desc {
  font-size: 0.85rem;
  line-height: 1.6;
  color: #94a3b8;
  max-width: 300px;
}
.footer-heading {
  color: #f8fafc;
  font-size: 0.9rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
}
.footer-links li { margin-bottom: 0.4rem; }
.footer-links a {
  color: #94a3b8;
  text-decoration: none;
  font-size: 0.85rem;
  transition: color 0.2s;
}
.footer-links a:hover { color: #0ea5e9; }
.footer-contact {
  font-size: 0.85rem;
  color: #94a3b8;
  margin-bottom: 0.75rem;
}
.footer-cta {
  display: inline-block;
  background: #25d366;
  color: #fff;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 0.5rem 1rem;
  border-radius: 0.375rem;
  transition: background 0.2s;
}
.footer-cta:hover { background: #1da851; }
.footer-bottom {
  max-width: 1200px;
  margin: 2rem auto 0;
  padding-top: 1.5rem;
  border-top: 1px solid #1e293b;
  text-align: center;
  font-size: 0.8rem;
  color: #64748b;
}
@media (max-width: 768px) {
  .footer-inner { grid-template-columns: 1fr; gap: 1.5rem; }
}
</style>
