---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import FAQ from '../../components/FAQ.astro';
import StructuredData from '../../components/StructuredData.astro';
import ProductCard from '../../components/ProductCard.astro';
import { allProducts, getProductBySlug } from '../../data/products-index';
import type { Product } from '../../data/types';

export function getStaticPaths() {
  return allProducts.map((product) => ({
    params: { slug: product.slug },
  }));
}

interface Props {
  product: Product;
}
const { slug } = Astro.params;
const product = getProductBySlug(slug!) as Product;
const relatedProducts = product.relatedSlugs
  .map((s) => getProductBySlug(s))
  .filter((p): p is Product => p !== undefined);
---

<Layout
  title={product.metaTitle}
  description={product.metaDescription}
  canonicalPath={`/products/${product.slug}`}
  keywords={product.keywords}
>
  <StructuredData product={product} />
  <Breadcrumbs
    crumbs={[
      { label: 'Home', href: '/' },
      { label: product.category, href: `/categories/${product.categorySlug}` },
      { label: product.name },
    ]}
  />

  <div class="product-page">
    <div class="product-hero">
      <div class="hero-content">
        <span class="hero-category">{product.category}</span>
        <h1>{product.name}</h1>
        <p class="hero-tagline">{product.tagline}</p>
        <div class="hero-meta">
          <span class="hs-badge" data-status={product.hsCodeStatus}>
            HS Code: {product.hsCode}
            {product.hsCodeStatus === 'verified' && ' (Verified)'}
            {product.hsCodeStatus === 'conditional' && ' (Conditional)'}
          </span>
        </div>
        {product.hsCodeNote && (
          <p class="hs-note">{product.hsCodeNote}</p>
        )}
        <div class="hero-cta">
          <WhatsAppCTA
            productName={product.name}
            hsCode={product.hsCode}
            category={product.category}
          />
        </div>
      </div>
      <div class="hero-icon" data-icon={product.imageIcon}>
        <span class="hero-glyph">{product.name.charAt(0)}</span>
      </div>
    </div>

    <div class="product-intro">
      <p>{product.introduction}</p>
    </div>

    <div class="product-content">
      {product.sections.map((section) => (
        <section class="content-section">
          <h2>{section.heading}</h2>
          {section.paragraphs?.map((para) => (
            <p>{para}</p>
          ))}
          {section.list && (
            <ul>
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>

    <div class="mid-cta">
      <WhatsAppCTA
        productName={product.name}
        hsCode={product.hsCode}
        category={product.category}
      />
    </div>

    <FAQ faqs={product.faqs} />

    {relatedProducts.length > 0 && (
      <div class="related-section">
        <h2 class="related-heading">Related Products</h2>
        <div class="related-grid">
          {relatedProducts.map((rp) => (
            <ProductCard product={rp} />
          ))}
        </div>
      </div>
    )}

    <div class="bottom-cta">
      <h2>Request a Quote for {product.name}</h2>
      <p>Ready to source {product.name.toLowerCase()} from Iran? Send us an inquiry on WhatsApp and we'll respond with available options, specifications and export terms.</p>
      <WhatsAppCTA
        productName={product.name}
        hsCode={product.hsCode}
        category={product.category}
      />
    </div>
  </div>
</Layout>

<style>
.product-page {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 1.5rem 2rem;
}
.product-hero {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 2rem;
  align-items: center;
  padding: 2rem 0;
  border-bottom: 2px solid #e2e8f0;
  margin-bottom: 2rem;
}
.hero-content { flex: 1; }
.hero-category {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #0ea5e9;
  margin-bottom: 0.5rem;
}
.product-hero h1 {
  font-size: 2.25rem;
  font-weight: 800;
  margin: 0 0 0.5rem;
  line-height: 1.2;
}
.hero-tagline {
  font-size: 1.1rem;
  color: #475569;
  margin: 0 0 1rem;
  line-height: 1.5;
}
.hero-meta {
  margin-bottom: 0.75rem;
}
.hs-badge {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.3rem 0.75rem;
  border-radius: 0.375rem;
  background: #f1f5f9;
  color: #475569;
}
.hs-badge[data-status="verified"] { background: #dcfce7; color: #166534; }
.hs-badge[data-status="conditional"] { background: #fef9c3; color: #854d0e; }
.hs-badge[data-status="unverified"] { background: #fee2e2; color: #991b1b; }
.hs-note {
  font-size: 0.8rem;
  color: #64748b;
  margin: 0.5rem 0 1rem;
  line-height: 1.5;
  padding: 0.75rem;
  background: #f8fafc;
  border-left: 3px solid #cbd5e1;
  border-radius: 0.25rem;
}
.hero-icon {
  width: 120px;
  height: 120px;
  border-radius: 1rem;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hero-glyph {
  font-size: 3.5rem;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.9);
  text-transform: uppercase;
}
.hero-cta { margin-top: 1rem; }
.product-intro {
  font-size: 1.05rem;
  color: #334155;
  line-height: 1.7;
  margin-bottom: 2rem;
  padding: 1.5rem;
  background: #f8fafc;
  border-radius: 0.5rem;
  border-left: 4px solid #0ea5e9;
}
.product-content { margin-bottom: 2rem; }
.content-section {
  margin-bottom: 2rem;
}
.content-section h2 {
  font-size: 1.4rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid #e2e8f0;
}
.content-section p {
  font-size: 0.95rem;
  line-height: 1.7;
  color: #334155;
  margin: 0 0 0.75rem;
}
.content-section ul {
  padding-left: 1.5rem;
  margin: 0.5rem 0;
}
.content-section li {
  font-size: 0.9rem;
  line-height: 1.7;
  color: #334155;
  margin-bottom: 0.4rem;
}
.mid-cta {
  padding: 2rem;
  background: #f0f9ff;
  border-radius: 0.75rem;
  margin: 2rem 0;
  text-align: center;
}
.related-section {
  margin: 3rem 0;
}
.related-heading {
  font-size: 1.5rem;
  font-weight: 800;
  margin-bottom: 1.5rem;
  text-align: center;
}
.related-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1.25rem;
}
.bottom-cta {
  text-align: center;
  padding: 2.5rem 1.5rem;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  border-radius: 1rem;
  margin: 3rem 0 0;
  color: #cbd5e1;
}
.bottom-cta h2 {
  color: #f8fafc;
  font-size: 1.5rem;
  margin-bottom: 0.75rem;
}
.bottom-cta p {
  font-size: 0.9rem;
  margin-bottom: 1.25rem;
  max-width: 500px;
  margin-left: auto;
  margin-right: auto;
}
.bottom-cta :global(.whatsapp-cta) {
  align-items: center;
}
@media (max-width: 768px) {
  .product-hero {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .hero-icon {
    margin: 0 auto;
  }
  .hero-cta :global(.whatsapp-cta) {
    align-items: center;
  }
  .product-hero h1 {
    font-size: 1.75rem;
  }
}
</style>
