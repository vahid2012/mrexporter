---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import { allProducts } from '../../data/products-index';
import { categories } from '../../data/categories';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'All Products — Mr Exporter',
  description: 'Browse all 33 export products from Iran across petrochemicals, metals, industrial goods, food and handicrafts.',
  url: 'https://mrexporter.ir/products',
};
---

<Layout
  title="All Products | Mr Exporter — Iran Export Hub"
  description="Browse all 33 export products from Iran across petrochemicals, metals, industrial goods, shelf-stable foods and Persian handicrafts. Request quotes via WhatsApp."
  canonicalPath="/products"
  structuredData={structuredData}
>
  <Breadcrumbs
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'All Products' },
    ]}
  />

  <div class="products-index-page">
    <div class="page-hero">
      <h1>All Export Products</h1>
      <p class="hero-desc">
        Browse our complete catalog of {allProducts.length} Iranian export products across five categories.
        Click any product for detailed specifications, HS codes, export documentation guidance and WhatsApp inquiry.
      </p>
      <WhatsAppCTA />
    </div>

    {categories.map((cat) => {
      const catProducts = allProducts.filter((p) => p.categorySlug === cat.slug);
      return (
        <section class="category-section">
          <div class="section-header">
            <h2>{cat.name}</h2>
            <a href={`/categories/${cat.slug}`} class="view-all">View all →</a>
          </div>
          <p class="section-desc">{cat.shortDescription}</p>
          <div class="product-grid">
            {catProducts.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<style>
.products-index-page {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem 2rem;
}
.page-hero {
  text-align: center;
  padding: 2rem 0 3rem;
  border-bottom: 2px solid #e2e8f0;
  margin-bottom: 2rem;
}
.page-hero h1 {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 0.75rem;
}
.hero-desc {
  font-size: 1.05rem;
  color: #475569;
  max-width: 700px;
  margin: 0 auto 1.5rem;
  line-height: 1.6;
}
.page-hero :global(.whatsapp-cta) {
  align-items: center;
}
.category-section {
  margin-bottom: 3rem;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 0.5rem;
}
.section-header h2 {
  font-size: 1.5rem;
  font-weight: 800;
}
.view-all {
  font-size: 0.85rem;
  text-decoration: none;
  font-weight: 600;
  transition: color 0.2s;
}
.view-all:hover { color: #0284c7; }
.section-desc {
  font-size: 0.9rem;
  color: #64748b;
  margin-bottom: 1.25rem;
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1.25rem;
}
</style>
