---
import type { Product } from '../data/types';

interface Props {
  product: Product;
}
const { product } = Astro.props;

const siteUrl = 'https://mrexporter.ir';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.metaDescription,
  category: product.category,
  url: `${siteUrl}/products/${product.slug}`,
  brand: {
    '@type': 'Brand',
    name: 'Mr Exporter',
  },
  additionalProperty: [
    {
      '@type': 'PropertyValue',
      name: 'HS Code',
      value: product.hsCode,
    },
  ],
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${siteUrl}/products/${product.slug}`,
  },
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: product.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: product.category,
      item: `${siteUrl}/categories/${product.categorySlug}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: product.name,
      item: `${siteUrl}/products/${product.slug}`,
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
<script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
