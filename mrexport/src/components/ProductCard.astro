---
import type { Product } from '../data/types';

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<a href={`/products/${product.slug}`} class="product-card">
  <div class="card-icon" data-icon={product.imageIcon}>
    <span class="icon-glyph">{product.name.charAt(0)}</span>
  </div>
  <div class="card-body">
    <h3 class="card-title">{product.name}</h3>
    <p class="card-tagline">{product.tagline}</p>
    <div class="card-meta">
      <span class="hs-badge" data-status={product.hsCodeStatus}>HS {product.hsCode}</span>
      <span class="category-badge">{product.category}</span>
    </div>
  </div>
</a>

<style>
.product-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 0.75rem;
  overflow: hidden;
  text-decoration: none;
  transition: all 0.25s;
  height: 100%;
}
.product-card:hover {
  border-color: #0ea5e9;
  box-shadow: 0 8px 24px rgba(14, 165, 233, 0.12);
  transform: translateY(-4px);
}
.card-icon {
  height: 100px;
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-glyph {
  font-size: 2.5rem;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.85);
  text-transform: uppercase;
}
.card-body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  flex: 1;
}
.card-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #0f172a;
  margin: 0;
  line-height: 1.3;
}
.card-tagline {
  font-size: 0.82rem;
  color: #64748b;
  line-height: 1.5;
  margin: 0;
  flex: 1;
}
.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.25rem;
}
.hs-badge {
  font-size: 0.7rem;
  font-weight: 600;
  padding: 0.2rem 0.5rem;
  border-radius: 0.25rem;
  background: #f1f5f9;
  color: #475569;
}
.hs-badge[data-status="verified"] {
  background: #dcfce7;
  color: #166534;
}
.hs-badge[data-status="conditional"] {
  background: #fef9c3;
  color: #854d0e;
}
.hs-badge[data-status="unverified"] {
  background: #fee2e2;
  color: #991b1b;
}
.category-badge {
  font-size: 0.7rem;
  font-weight: 500;
  padding: 0.2rem 0.5rem;
  border-radius: 0.25rem;
  background: #e0f2fe;
  color: #075985;
}
</style>
